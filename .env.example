# Keep this file private. Never expose this key to the browser or commit .env.
NVIDIA_API_KEY=nvapi-your-key-here
# Optional: a comma-separated fallback list. The first available model is used.
NVIDIA_MODEL=openai/gpt-oss-20b,deepseek-ai/deepseek-v4-flash-0731
PORT=3000
# Optional. Leave blank for local development; use your deployed backend URL for Capacitor builds.
ALLOWED_ORIGIN=
